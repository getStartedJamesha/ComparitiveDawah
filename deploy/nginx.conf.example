# Optional: only needed if you later want a domain name, TLS, or to run
# several apps behind one port 80/443. Not required to reach the app on
# your local network at http://<pi-ip>:4173 — see DEPLOYMENT.md.
#
# Install: sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/comparativedawah
#          sudo ln -s /etc/nginx/sites-available/comparativedawah /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name dawah.local;  # replace with your domain or the Pi's hostname

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
